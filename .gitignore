# Auth config — contains the password hash + session secret. Never commit.
# Generated by scripts/set_password.py. See docs/AUTH.md.
auth_config.json

# API keys — real config lives in config.json; only config.example.json is committed.
config.json
.env

# Personal collection data (user's own pens/inks/papers/photos)
tracker/pens.json
tracker/inks.json
tracker/papers.json
tracker/photos.json
tracker/catalog_learned.json
tracker/photos/
tracker/backups/
tracker/uploads/

# Runtime logs — tracebacks contain absolute local paths (incl. Windows username) and client IPs
*.log
tracker/_source/pens.md
tracker/.reddit-device-id

# Scraped third-party retailer caches used to build ink_catalog.json (not for redistribution)
tracker/_source/cache_*

# Build output — publish the .exe/.zip as GitHub Release assets instead.
# dist/README.md stays tracked.
dist/*
!dist/README.md

# Old snapshots and working folders
archive/

# Design mockups containing real collection data / seller usernames
tracker/_design/

# Local tooling / Python
.claude/
__pycache__/
*.pyc
